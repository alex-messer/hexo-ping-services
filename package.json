{
  "name": "hexo-ping-services",
  "version": "0.3.4",
  "description": "Notify IndexNow, XML-RPC, and WebSub update services on Hexo publish/update.",
  "license": "MIT",
  "author": "alex-messer <alex@messer.pw>",
  "main": "./index.js",
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test test/*.test.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install || true"
  },
  "peerDependencies": {
    "hexo": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "c8": "^12.0.0",
    "hexo": "^8.1.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.75.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.7"
  },
  "keywords": [
    "hexo",
    "hexo-plugin",
    "indexnow",
    "xml-rpc",
    "websub",
    "pubsubhubbub",
    "weblogupdates",
    "ping",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-messer/hexo-ping-services.git"
  },
  "bugs": {
    "url": "https://github.com/alex-messer/hexo-ping-services/issues"
  },
  "homepage": "https://github.com/alex-messer/hexo-ping-services#readme"
